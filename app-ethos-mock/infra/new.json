{
  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "EC2Read",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2CreateNewResource",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateNatGateway",
        "ec2:AllocateAddress",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:*:816583873447:vpc/*",
        "arn:aws:ec2:*:816583873447:subnet/*",
        "arn:aws:ec2:*:816583873447:internet-gateway/*",
        "arn:aws:ec2:*:816583873447:route-table/*",
        "arn:aws:ec2:*:816583873447:natgateway/*",
        "arn:aws:ec2:*:816583873447:elastic-ip/*",
        "arn:aws:ec2:*:816583873447:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "EC2CreateOnOwnedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:*:816583873447:vpc/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },
    {
      "Sid": "EC2TagOnCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateNatGateway",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "EC2MutateOwn",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteNatGateway",
        "ec2:ReleaseAddress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "EC2MutateOnOwnedVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:*:816583873447:vpc/*",
        "arn:aws:ec2:*:816583873447:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "ECSRead",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ECSCreate",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:CreateService",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "ECSMutateOwn",
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteCluster",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "ALBRead",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ALBCreate",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateRule"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "ALBMutateOwn",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:DeleteRule",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "ECRRead",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ECRCreate",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "ECRMutateOwn",
      "Effect": "Allow",
      "Action": [
        "ecr:DeleteRepository",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "IAM",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::816583873447:role/ethos-cand-jesus-eduardo85-*"
    },

    {
      "Sid": "LogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsCreate",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "LogsMutateOwn",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },

    {
      "Sid": "EKS",
      "Effect": "Allow",
      "Action": [
        "eks:CreateCluster",
        "eks:DeleteCluster",
        "eks:DescribeCluster",
        "eks:ListClusters",
        "eks:UpdateClusterConfig",
        "eks:UpdateClusterVersion",
        "eks:CreateNodegroup",
        "eks:DeleteNodegroup",
        "eks:DescribeNodegroup",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion",
        "eks:CreateAddon",
        "eks:DeleteAddon",
        "eks:DescribeAddon",
        "eks:TagResource",
        "eks:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },
    {
      "Sid": "EKSCreate",
      "Effect": "Allow",
      "Action": [
        "eks:CreateCluster",
        "eks:CreateNodegroup",
        "eks:CreateAddon"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "SSMReadPublic",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/*"
    },

    {
      "Sid": "STS",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KMSRead",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:ListKeys",
        "kms:ListAliases",
        "kms:GetKeyPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KMSCreate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    },
    {
      "Sid": "KMSMutateOwn",
      "Effect": "Allow",
      "Action": [
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:UpdateAlias",
        "kms:DeleteAlias",
        "kms:PutKeyPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ethos:candidate": "jesus-eduardo85"
        }
      }
    },
    {
      "Sid": "KMSCreateAndTag",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ethos:candidate": "jesus-eduardo85",
          "aws:RequestTag/ethos:project": "devops-test"
        }
      }
    }

  ]
}